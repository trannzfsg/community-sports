rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? currentUserDoc().data.role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && currentUserRole() == 'admin';
    }

    function isOrganiser() {
      return isSignedIn() && currentUserRole() == 'organiser';
    }

    function isPlayer() {
      return isSignedIn() && currentUserRole() == 'player';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function signedInEmail() {
      return isSignedIn() && request.auth.token.email != null
        ? request.auth.token.email
        : null;
    }

    function partitionForEmail(email) {
      return email != null && email.matches('.*@example\\.com$')
        ? 'test'
        : 'live';
    }

    function requestPartition() {
      return signedInEmail() != null
        ? partitionForEmail(signedInEmail())
        : (
          isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            ? userPartitionFromData(currentUserDoc().data)
            : null
        );
    }

    function userPartitionFromData(data) {
      return data.get('dataPartition', data.email is string ? partitionForEmail(data.email) : null);
    }

    function playerPartitionFromData(data) {
      return data.get('dataPartition', data.email is string ? partitionForEmail(data.email) : null);
    }

    function managedPartitionFromData(data) {
      return data.get('dataPartition', data.email is string ? partitionForEmail(data.email) : null);
    }

    function partitionForUserId(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        ? userPartitionFromData(get(/databases/$(database)/documents/users/$(userId)).data)
        : null;
    }

    function sessionPartitionFromData(data) {
      return data.get('dataPartition', partitionForUserId(data.organiserId));
    }

    function eventPartitionFromData(data) {
      return data.get('dataPartition', partitionForUserId(data.organiserId));
    }

    function sessionPartitionById(sessionId) {
      return exists(/databases/$(database)/documents/sessions/$(sessionId))
        ? sessionPartitionFromData(get(/databases/$(database)/documents/sessions/$(sessionId)).data)
        : null;
    }

    function eventPartitionById(eventId) {
      return exists(/databases/$(database)/documents/sessionEvents/$(eventId))
        ? eventPartitionFromData(get(/databases/$(database)/documents/sessionEvents/$(eventId)).data)
        : null;
    }

    function registrationPartitionFromData(data) {
      return data.get('dataPartition', eventPartitionById(data.sessionEventId));
    }

    function paymentPartitionFromData(data) {
      return data.get('dataPartition',
        exists(/databases/$(database)/documents/registrations/$(data.registrationId))
          ? registrationPartitionFromData(get(/databases/$(database)/documents/registrations/$(data.registrationId)).data)
          : null
      );
    }

    function approvalPartitionFromData(data) {
      return data.get('dataPartition', partitionForUserId(data.organiserId));
    }

    function emailPartitionMatches(partition, email) {
      return email is string && partition == partitionForEmail(email);
    }

    function userDataMatchesPartition(data) {
      return data.email is string
        && userPartitionFromData(data) == partitionForEmail(data.email);
    }

    function managedDataMatchesPartition(data) {
      return data.email is string
        && managedPartitionFromData(data) == partitionForEmail(data.email)
        && data.role in ['player', 'organiser'];
    }

    function playerDataMatchesPartition(data) {
      return data.email is string
        && playerPartitionFromData(data) == partitionForEmail(data.email)
        && (
          data.ownerOrganiserId == null
          || playerPartitionFromData(data) == partitionForUserId(data.ownerOrganiserId)
        )
        && (
          data.userId == null
          || (
            exists(/databases/$(database)/documents/users/$(data.userId))
            && playerPartitionFromData(data) == partitionForUserId(data.userId)
          )
        );
    }

    function sessionDataMatchesPartition(data) {
      return sessionPartitionFromData(data) != null
        && sessionPartitionFromData(data) == partitionForUserId(data.organiserId);
    }

    function eventDataMatchesPartition(data) {
      return eventPartitionFromData(data) != null
        && eventPartitionFromData(data) == partitionForUserId(data.organiserId)
        && eventPartitionFromData(data) == sessionPartitionById(data.sessionSeriesId);
    }

    function registrationDataMatchesPartition(data) {
      return exists(/databases/$(database)/documents/sessionEvents/$(data.sessionEventId))
        && registrationPartitionFromData(data) == eventPartitionById(data.sessionEventId)
        && emailPartitionMatches(registrationPartitionFromData(data), data.playerEmail);
    }

    function paymentDataMatchesPartition(data) {
      return exists(/databases/$(database)/documents/registrations/$(data.registrationId))
        && paymentPartitionFromData(data) == registrationPartitionFromData(
          get(/databases/$(database)/documents/registrations/$(data.registrationId)).data
        )
        && emailPartitionMatches(paymentPartitionFromData(data), data.playerEmail);
    }

    function partitionMatchesRequest(partition) {
      return partition != null && partition == requestPartition();
    }

    function hasPendingUserForSignedInEmail() {
      return signedInEmail() != null
        && exists(/databases/$(database)/documents/managedUsers/$(signedInEmail()))
        && get(/databases/$(database)/documents/managedUsers/$(signedInEmail())).data.isPending == true;
    }

    function pendingUserForSignedInEmail() {
      return get(/databases/$(database)/documents/managedUsers/$(signedInEmail()));
    }

    function allowedSelfRegistrationRole() {
      return hasPendingUserForSignedInEmail()
        ? pendingUserForSignedInEmail().data.role
        : 'player';
    }

    function allowedSelfRegistrationStatus() {
      return hasPendingUserForSignedInEmail()
        ? pendingUserForSignedInEmail().data.status
        : 'active';
    }

    function seriesOwnedByCurrentOrganiser() {
      return isSignedIn() && resource.data.organiserId == request.auth.uid;
    }

    function newSeriesOwnedByCurrentOrganiser() {
      return isSignedIn() && request.resource.data.organiserId == request.auth.uid;
    }

    function eventOwnedByCurrentOrganiser() {
      return isSignedIn() && resource.data.organiserId == request.auth.uid;
    }

    function eventBelongsToCurrentOrganiserBySeries() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sessions/$(resource.data.sessionSeriesId))
        && get(/databases/$(database)/documents/sessions/$(resource.data.sessionSeriesId)).data.organiserId == request.auth.uid;
    }

    function newEventOwnedByCurrentOrganiser() {
      return isSignedIn() && request.resource.data.organiserId == request.auth.uid;
    }

    function validSport(value) {
      return value in ['Badminton', 'Basketball'];
    }

    function validDayOfWeek(value) {
      return value in ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
    }

    function signedInUserOwnsSeries(seriesId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sessions/$(seriesId))
        && get(/databases/$(database)/documents/sessions/$(seriesId)).data.organiserId == request.auth.uid;
    }

    function signedInUserOwnsEvent(eventId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sessionEvents/$(eventId))
        && get(/databases/$(database)/documents/sessionEvents/$(eventId)).data.organiserId == request.auth.uid;
    }

    function signedInUserOwnsEventBySeries(eventId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/sessionEvents/$(eventId))
        && signedInUserOwnsSeries(
          get(/databases/$(database)/documents/sessionEvents/$(eventId)).data.sessionSeriesId
        );
    }

    function registrationOwnedByCurrentUser() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function registrationForOrganiserEvent() {
      return signedInUserOwnsEvent(resource.data.sessionEventId)
        || signedInUserOwnsEventBySeries(resource.data.sessionEventId);
    }

    function newRegistrationForOrganiserEvent() {
      return signedInUserOwnsEvent(request.resource.data.sessionEventId)
        || signedInUserOwnsEventBySeries(request.resource.data.sessionEventId);
    }

    // Simpler check: verify registration's sessionSeriesId belongs to organiser.
    // Used as fallback when event-based checks fail (e.g. missing organiserId on event doc).
    function newRegistrationForOrganiserSeries() {
      return signedInUserOwnsSeries(request.resource.data.sessionSeriesId);
    }

    function registrationForOrganiserSeries() {
      return signedInUserOwnsSeries(resource.data.sessionSeriesId);
    }

    function paymentHasOwnedRegistration() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/registrations/$(resource.data.registrationId))
        && get(/databases/$(database)/documents/registrations/$(resource.data.registrationId)).data.userId == request.auth.uid;
    }

    function newPaymentHasOwnedRegistration() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId))
        && get(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.userId == request.auth.uid;
    }

    function paymentBelongsToOrganiserByRegistration() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/registrations/$(resource.data.registrationId))
        && (
          signedInUserOwnsEvent(get(/databases/$(database)/documents/registrations/$(resource.data.registrationId)).data.sessionEventId)
          || signedInUserOwnsSeries(get(/databases/$(database)/documents/registrations/$(resource.data.registrationId)).data.sessionSeriesId)
        );
    }

    function newPaymentBelongsToOrganiserByRegistration() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId))
        && (
          signedInUserOwnsEvent(get(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.sessionEventId)
          || signedInUserOwnsSeries(get(/databases/$(database)/documents/registrations/$(request.resource.data.registrationId)).data.sessionSeriesId)
        );
    }

    function registrationEventIsLocked() {
      return exists(/databases/$(database)/documents/sessionEvents/$(resource.data.sessionEventId))
        && get(/databases/$(database)/documents/sessionEvents/$(resource.data.sessionEventId)).data.get('locked', false) == true;
    }

    function newRegistrationEventIsLocked() {
      return exists(/databases/$(database)/documents/sessionEvents/$(request.resource.data.sessionEventId))
        && get(/databases/$(database)/documents/sessionEvents/$(request.resource.data.sessionEventId)).data.get('locked', false) == true;
    }

    function paymentEventIsLocked() {
      return exists(/databases/$(database)/documents/sessionEvents/$(resource.data.sessionEventId))
        && get(/databases/$(database)/documents/sessionEvents/$(resource.data.sessionEventId)).data.get('locked', false) == true;
    }

    function newPaymentEventIsLocked() {
      return exists(/databases/$(database)/documents/sessionEvents/$(request.resource.data.sessionEventId))
        && get(/databases/$(database)/documents/sessionEvents/$(request.resource.data.sessionEventId)).data.get('locked', false) == true;
    }

    function manualPlayerSelfLinkUpdate() {
      return isSignedIn()
        && resource.data.ownerOrganiserId != null
        && resource.data.userId == null
        && resource.data.email is string
        && signedInEmail() != null
        && resource.data.email == signedInEmail()
        && playerDataMatchesPartition(resource.data)
        && playerDataMatchesPartition(request.resource.data)
        && request.resource.data.ownerOrganiserId == resource.data.ownerOrganiserId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.email == resource.data.email
        && request.resource.data.source == resource.data.source
        && request.resource.data.skillLevel == resource.data.skillLevel;
    }

    function approvalDocId(organiserId, playerId) {
      return organiserId + "__" + playerId;
    }

    function organiserHasApprovedPlayer(organiserId, playerId) {
      return exists(
          /databases/$(database)/documents/organiserApprovals/$(approvalDocId(organiserId, playerId))
        )
        && get(
          /databases/$(database)/documents/organiserApprovals/$(approvalDocId(organiserId, playerId))
        ).data.status == "approved";
    }

    function signedInPlayerApprovedForOrganiser(organiserId) {
      return isSignedIn() && organiserHasApprovedPlayer(organiserId, request.auth.uid);
    }

    function registrationUserNeedsApproval(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.role == "player";
    }

    match /users/{userId} {
      allow read: if isOwner(userId)
        || ((isAdmin() || isOrganiser()) && resource.data.dataPartition == requestPartition());

      allow create: if (isAdmin()
          && partitionMatchesRequest(userPartitionFromData(request.resource.data))
          && userDataMatchesPartition(request.resource.data))
        || (isOwner(userId)
          && request.resource.data.get('isPending', false) != true
          && request.resource.data.email == signedInEmail()
          && request.resource.data.role == allowedSelfRegistrationRole()
          && request.resource.data.status == allowedSelfRegistrationStatus()
          && partitionMatchesRequest(userPartitionFromData(request.resource.data))
          && userDataMatchesPartition(request.resource.data))
        ;

      allow update: if (isAdmin()
          && partitionMatchesRequest(userPartitionFromData(resource.data))
          && partitionMatchesRequest(userPartitionFromData(request.resource.data)))
          && userDataMatchesPartition(resource.data)
          && userDataMatchesPartition(request.resource.data)
        || (isOwner(userId)
          && request.resource.data.get('isPending', false) != true
          && request.resource.data.email == resource.data.email
          && request.resource.data.role == resource.data.role
          && partitionMatchesRequest(userPartitionFromData(resource.data))
          && userDataMatchesPartition(resource.data)
          && userDataMatchesPartition(request.resource.data))
        || (isOwner(userId)
          && request.resource.data.get('isPending', false) != true
          && request.resource.data.email == signedInEmail()
          && request.resource.data.role == resource.data.role
          && partitionMatchesRequest(userPartitionFromData(request.resource.data))
          && userDataMatchesPartition(request.resource.data))
        || (isOwner(userId)
          && request.resource.data.get('isPending', false) != true
          && hasPendingUserForSignedInEmail()
          && request.resource.data.role == allowedSelfRegistrationRole()
          && request.resource.data.status == allowedSelfRegistrationStatus()
          && partitionMatchesRequest(userPartitionFromData(request.resource.data))
          && userDataMatchesPartition(request.resource.data))
        ;

      allow delete: if isAdmin() && partitionMatchesRequest(userPartitionFromData(resource.data));
    }

    match /managedUsers/{managedUserId} {
      allow read: if (isAdmin() || isOrganiser()) && resource.data.dataPartition == requestPartition()
        || (isSignedIn() && managedUserId == signedInEmail() && resource.data.dataPartition == requestPartition());

      allow create: if (isAdmin()
          && request.resource.data.dataPartition == requestPartition()
          && managedDataMatchesPartition(request.resource.data))
        || (isOrganiser()
          && request.resource.data.role == 'player'
          && request.resource.data.dataPartition == requestPartition()
          && managedDataMatchesPartition(request.resource.data));

      allow update: if (isAdmin()
          && resource.data.dataPartition == requestPartition()
          && request.resource.data.dataPartition == requestPartition()
          && managedDataMatchesPartition(resource.data)
          && managedDataMatchesPartition(request.resource.data))
        || (isOrganiser()
          && resource.data.role == 'player'
          && request.resource.data.role == 'player'
          && resource.data.dataPartition == requestPartition()
          && request.resource.data.dataPartition == requestPartition()
          && managedDataMatchesPartition(resource.data)
          && managedDataMatchesPartition(request.resource.data));

      allow delete: if (isAdmin() && partitionMatchesRequest(managedPartitionFromData(resource.data)))
        || (isOrganiser() && resource.data.role == 'player' && partitionMatchesRequest(managedPartitionFromData(resource.data)));
    }

    match /players/{playerId} {
      allow read: if (isAdmin() && resource.data.dataPartition == requestPartition())
        || (isPlayer() && resource.data.dataPartition == requestPartition())
        || (isOrganiser() && resource.data.dataPartition == requestPartition() && (resource.data.ownerOrganiserId == request.auth.uid || resource.data.ownerOrganiserId == null))
        || (isSignedIn() && resource != null && resource.data.userId == request.auth.uid);
      allow create: if (isAdmin() && partitionMatchesRequest(playerPartitionFromData(request.resource.data)))
        && playerDataMatchesPartition(request.resource.data)
        || (isOrganiser() && request.resource.data.ownerOrganiserId == request.auth.uid && partitionMatchesRequest(playerPartitionFromData(request.resource.data)) && playerDataMatchesPartition(request.resource.data))
        || (isSignedIn() && request.resource.data.userId == request.auth.uid && request.resource.data.ownerOrganiserId == null && request.resource.data.email == signedInEmail() && partitionMatchesRequest(playerPartitionFromData(request.resource.data)) && playerDataMatchesPartition(request.resource.data));
      allow update: if (isAdmin() && partitionMatchesRequest(playerPartitionFromData(resource.data)) && partitionMatchesRequest(playerPartitionFromData(request.resource.data)))
        && playerDataMatchesPartition(resource.data)
        && playerDataMatchesPartition(request.resource.data)
        || manualPlayerSelfLinkUpdate()
        || (isOrganiser()
          && partitionMatchesRequest(playerPartitionFromData(resource.data))
          && resource.data.ownerOrganiserId == request.auth.uid
          && resource.data.userId == null
          && request.resource.data.userId == null
          && playerDataMatchesPartition(resource.data)
          && playerDataMatchesPartition(request.resource.data))
        || (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.ownerOrganiserId == null && partitionMatchesRequest(playerPartitionFromData(resource.data)) && playerDataMatchesPartition(resource.data) && playerDataMatchesPartition(request.resource.data));
      allow delete: if (isAdmin() && partitionMatchesRequest(playerPartitionFromData(resource.data)))
        || (isOrganiser() && partitionMatchesRequest(playerPartitionFromData(resource.data)) && resource.data.ownerOrganiserId == request.auth.uid && resource.data.userId == null);
    }

    match /sessions/{sessionId} {
      allow read: if (isAdmin() && resource.data.dataPartition == requestPartition())
        || (isPlayer()
          && resource.data.dataPartition == requestPartition()
          && signedInPlayerApprovedForOrganiser(resource.data.organiserId))
        || (isOrganiser() && resource.data.dataPartition == requestPartition() && seriesOwnedByCurrentOrganiser());
      allow create: if ((isAdmin() || (isOrganiser() && newSeriesOwnedByCurrentOrganiser()))
        && partitionMatchesRequest(sessionPartitionFromData(request.resource.data))
        && sessionDataMatchesPartition(request.resource.data)
        && validSport(request.resource.data.typeOfSport)
        && validDayOfWeek(request.resource.data.dayOfWeek));
      allow update, delete: if ((isAdmin() || (isOrganiser() && seriesOwnedByCurrentOrganiser()))
        && partitionMatchesRequest(sessionPartitionFromData(resource.data))
        && partitionMatchesRequest(sessionPartitionFromData(request.resource.data))
        && sessionDataMatchesPartition(resource.data)
        && sessionDataMatchesPartition(request.resource.data)
        && validSport(request.resource.data.typeOfSport)
        && validDayOfWeek(request.resource.data.dayOfWeek));
    }

    match /sessionEvents/{eventId} {
      allow read: if (isAdmin() && resource.data.dataPartition == requestPartition())
        || (isPlayer()
          && resource.data.dataPartition == requestPartition()
          && signedInPlayerApprovedForOrganiser(resource.data.organiserId))
        || (isOrganiser() && resource.data.dataPartition == requestPartition() && (eventOwnedByCurrentOrganiser() || eventBelongsToCurrentOrganiserBySeries()));
      allow create: if (isAdmin() || (isOrganiser() && newEventOwnedByCurrentOrganiser()))
        && partitionMatchesRequest(eventPartitionFromData(request.resource.data))
        && eventDataMatchesPartition(request.resource.data);
      allow update, delete: if ((isAdmin() || (isOrganiser() && eventOwnedByCurrentOrganiser()))
        && partitionMatchesRequest(eventPartitionFromData(resource.data))
        && partitionMatchesRequest(eventPartitionFromData(request.resource.data))
        && eventDataMatchesPartition(resource.data)
        && eventDataMatchesPartition(request.resource.data));
    }

    match /registrations/{registrationId} {
      allow read: if isSignedIn() && resource.data.dataPartition == requestPartition();
      allow create: if (isAdmin()
          || ((newRegistrationForOrganiserEvent() || newRegistrationForOrganiserSeries())
            && (!registrationUserNeedsApproval(request.resource.data.userId)
              || organiserHasApprovedPlayer(request.auth.uid, request.resource.data.userId)))
          || ((isSignedIn() && request.resource.data.userId == request.auth.uid)
            && signedInPlayerApprovedForOrganiser(
              get(/databases/$(database)/documents/sessionEvents/$(request.resource.data.sessionEventId)).data.organiserId
            )))
        && partitionMatchesRequest(registrationPartitionFromData(request.resource.data))
        && registrationDataMatchesPartition(request.resource.data)
        && !newRegistrationEventIsLocked();
      allow update: if ((isAdmin()
          && partitionMatchesRequest(registrationPartitionFromData(resource.data))
          && partitionMatchesRequest(registrationPartitionFromData(request.resource.data))
          && registrationDataMatchesPartition(resource.data)
          && registrationDataMatchesPartition(request.resource.data))
          && !registrationEventIsLocked())
        || ((registrationForOrganiserEvent() || registrationForOrganiserSeries()) && partitionMatchesRequest(registrationPartitionFromData(resource.data)) && registrationDataMatchesPartition(resource.data) && registrationDataMatchesPartition(request.resource.data) && !registrationEventIsLocked())
        || (registrationOwnedByCurrentUser()
          && partitionMatchesRequest(registrationPartitionFromData(resource.data))
          && registrationDataMatchesPartition(resource.data)
          && registrationDataMatchesPartition(request.resource.data)
          && !registrationEventIsLocked()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.sessionEventId == resource.data.sessionEventId
          && request.resource.data.sessionSeriesId == resource.data.sessionSeriesId
          && request.resource.data.playerName == resource.data.playerName
          && request.resource.data.playerEmail == resource.data.playerEmail
          && request.resource.data.organiserPaid == resource.data.organiserPaid);
      allow delete: if ((isAdmin()
          && partitionMatchesRequest(registrationPartitionFromData(resource.data))
          && registrationDataMatchesPartition(resource.data))
          && !registrationEventIsLocked())
        || ((registrationForOrganiserEvent() || registrationOwnedByCurrentUser()) && partitionMatchesRequest(registrationPartitionFromData(resource.data)) && registrationDataMatchesPartition(resource.data) && !registrationEventIsLocked());
    }

    match /payments/{paymentId} {
      allow read: if (isAdmin() && resource.data.dataPartition == requestPartition())
        || (isOrganiser() && resource.data.dataPartition == requestPartition() && (resource.data.organiserId == request.auth.uid || paymentBelongsToOrganiserByRegistration()))
        || (isSignedIn() && resource.data.dataPartition == requestPartition() && (resource.data.userId == request.auth.uid || paymentHasOwnedRegistration()));
      allow create: if (isAdmin()
          || (isOrganiser() && (request.resource.data.organiserId == request.auth.uid || newPaymentBelongsToOrganiserByRegistration()))
          || (isSignedIn() && (request.resource.data.userId == request.auth.uid || newPaymentHasOwnedRegistration())))
        && partitionMatchesRequest(paymentPartitionFromData(request.resource.data))
        && paymentDataMatchesPartition(request.resource.data)
        && !newPaymentEventIsLocked();
      allow update: if ((isAdmin()
            && partitionMatchesRequest(paymentPartitionFromData(resource.data))
            && partitionMatchesRequest(paymentPartitionFromData(request.resource.data))
            && paymentDataMatchesPartition(resource.data)
            && paymentDataMatchesPartition(request.resource.data))
          && !paymentEventIsLocked())
        || ((isOrganiser()
            && partitionMatchesRequest(paymentPartitionFromData(resource.data))
            && paymentDataMatchesPartition(resource.data)
            && paymentDataMatchesPartition(request.resource.data)
            && (resource.data.organiserId == request.auth.uid || paymentBelongsToOrganiserByRegistration())
            && (request.resource.data.organiserId == request.auth.uid || newPaymentBelongsToOrganiserByRegistration()))
          && !paymentEventIsLocked())
        || ((isSignedIn()
            && partitionMatchesRequest(paymentPartitionFromData(resource.data))
            && paymentDataMatchesPartition(resource.data)
            && paymentDataMatchesPartition(request.resource.data)
            && (resource.data.userId == request.auth.uid || paymentHasOwnedRegistration())
            && (request.resource.data.userId == request.auth.uid || newPaymentHasOwnedRegistration()))
          && !paymentEventIsLocked());
      allow delete: if ((isAdmin()
            && partitionMatchesRequest(paymentPartitionFromData(resource.data))
            && paymentDataMatchesPartition(resource.data))
          && !paymentEventIsLocked())
        || ((isOrganiser() && partitionMatchesRequest(paymentPartitionFromData(resource.data)) && paymentDataMatchesPartition(resource.data) && (resource.data.organiserId == request.auth.uid || paymentBelongsToOrganiserByRegistration()))
          && !paymentEventIsLocked())
        || ((isSignedIn() && partitionMatchesRequest(paymentPartitionFromData(resource.data)) && paymentDataMatchesPartition(resource.data) && (resource.data.userId == request.auth.uid || paymentHasOwnedRegistration()))
          && !paymentEventIsLocked());
    }

    match /organiserApprovals/{approvalId} {
      allow read: if (isAdmin() && resource.data.dataPartition == requestPartition())
        || (isOrganiser()
          && resource.data.dataPartition == requestPartition()
          && resource.data.organiserId == request.auth.uid)
        || (isPlayer()
          && resource.data.dataPartition == requestPartition()
          && resource.data.playerId == request.auth.uid);

      allow create: if (isPlayer()
          && request.resource.data.dataPartition == requestPartition()
          && request.resource.data.playerId == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.organiserId is string
          && exists(/databases/$(database)/documents/users/$(request.resource.data.organiserId))
          && get(/databases/$(database)/documents/users/$(request.resource.data.organiserId)).data.role == "organiser"
          && partitionForUserId(request.resource.data.organiserId) == requestPartition());

      allow update: if (isAdmin()
          && partitionMatchesRequest(approvalPartitionFromData(resource.data))
          && partitionMatchesRequest(approvalPartitionFromData(request.resource.data)))
        || (isOrganiser()
          && partitionMatchesRequest(approvalPartitionFromData(resource.data))
          && partitionMatchesRequest(approvalPartitionFromData(request.resource.data))
          && resource.data.organiserId == request.auth.uid
          && request.resource.data.organiserId == resource.data.organiserId
          && request.resource.data.playerId == resource.data.playerId
          && request.resource.data.status in ["pending", "approved", "rejected"]);

      allow delete: if (isAdmin() && partitionMatchesRequest(approvalPartitionFromData(resource.data)));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
